# Leave the API base URL empty to use the Vite dev proxy (same origin, no CORS needed).
# Set it to the API origin when the client is served from somewhere else, for example
# VITE_API_BASE_URL=https://localhost:7236
VITE_API_BASE_URL=

# Where the dev proxy forwards /api and /hubs. Must match the running API.
VITE_DEV_API_URL=http://localhost:5145
