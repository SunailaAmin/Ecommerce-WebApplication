{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=ECommerceDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "ECommerce.API",
    "Audience": "ECommerce.API",
    "Key": "",
    "AccessTokenMinutes": 60
  },
  "Payment": {
    "DeclineCardSuffix": "0000"
  },
  "CatalogCache": {
    "ProductListMinutes": 5,
    "ProductDetailMinutes": 10,
    "CategoryMinutes": 30
  },
  "OrderProcessing": {
    "AbandonedOrderTimeoutMinutes": 0,
    "CleanupIntervalMinutes": 15
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
